{
  "name": "mindseye-account-audit-trail-meaat",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Mind's Eye Account Audit Trail (MEAAT) — enclosed, offline accounting system with a split screen of state cards.",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "concurrently -n server,vite -c cyan,magenta \"node --watch server/index.mjs\" \"vite --config app/vite.config.js\"",
    "build": "vite build --config app/vite.config.js",
    "start": "node server/index.mjs --production",
    "test": "node --test --test-reporter=spec && node scripts/check-boundaries.mjs && node scripts/verify-space.mjs && node scripts/verify-attention.mjs",
    "demo": "node demo/demo.ledger.mjs",
    "report": "node demo/report.mjs",
    "verify": "node scripts/verify-journal.mjs",
    "check-boundaries": "node scripts/check-boundaries.mjs",
    "build:space": "node scripts/build-space.mjs",
    "test:cpp": "node scripts/test-cpp.mjs && node scripts/test-cpp-attention.mjs",
    "verify:space": "node scripts/verify-space.mjs",
    "gen:space-golden": "node scripts/gen-space-golden.mjs",
    "build:attention": "node scripts/build-attention.mjs",
    "test:attention": "node --test --test-reporter=spec test/attention/*.test.mjs",
    "verify:attention": "node scripts/verify-attention.mjs",
    "gen:attention-golden": "node scripts/gen-attention-golden.mjs",
    "emit:attention-css": "node scripts/emit-attention-css.mjs --force",
    "conduct": "echo 'python -m conductor build (implemented in S9)'",
    "conduct:verify": "echo 'python -m conductor verify (implemented in S9)'",
    "test:conductor": "echo 'python conductor tests (implemented in S9; skipped without Python)'"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "vite": "^5.4.0"
  }
}
